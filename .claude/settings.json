{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.envrc)",
      "Read(./**/*.pem)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.qodo/auth.key)",
      "Read(~/.claude/projects/**/*.jsonl)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Edit(./.envrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.qodo/**)"
    ],
    "ask": [
      "Bash(npm run dev)",
      "Bash(npm run test:integration)",
      "Bash(npm run test:integration *)",
      "Bash(npx vitest * vitest.integration*)",
      "Bash(npx vitest --config vitest.integration*)",
      "Bash(docker compose *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "docker compose *",
      "npm run dev",
      "npm run test:integration",
      "git push",
      "git push *",
      "qodo review *",
      "qodo read *"
    ],
    "filesystem": {
      "allowWrite": [
        "~/.npm"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config/gh",
        "~/.kube",
        "~/.npmrc",
        "~/.pypirc",
        "~/.qodo/auth.key",
        "~/.claude/projects",
        "./.env",
        "./.env.local",
        "./.env.development",
        "./.env.production",
        "./.env.test",
        "./.envrc",
        "./packages/app/.env",
        "./packages/app/.env.local"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "sdk.qodo.ai",
        "get.qodo.ai"
      ],
      "deniedDomains": [
        "169.254.169.254",
        "[fd00:ec2::254]",
        "metadata.google.internal"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-tool-use.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/om-harness/block-push-and-pr.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/om-harness/freeze-tests.sh\""
          }
        ]
      }
    ]
  }
}
