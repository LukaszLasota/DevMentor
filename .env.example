# PostgreSQL connection used by @devmentor/db (app runtime and MikroORM CLI).
DATABASE_URL=postgres://devmentor:devmentor@localhost:5432/devmentor
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
LOG_LEVEL=info

# Signing key for session cookies: at least 64 hex characters (32 random bytes).
# `npm run setup` generates one for a new .env; otherwise run `openssl rand -hex 32`.
# Required in production; without it auth routes fail closed.
SESSION_SECRET=
# Optional: the previous key during a rotation, so live sessions stay valid (verify only).
SESSION_SECRET_PREVIOUS=
# Absolute base URL of the app, used for the OAuth redirect and mail links. Required in production.
APP_URL=http://localhost:3000

# GitHub OAuth App (README, "Create GitHub OAuth App"). Empty = GitHub sign-in is unavailable.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# DEVMENTOR_GITHUB_OAUTH_URL / DEVMENTOR_GITHUB_API_URL (default https://github.com / https://api.github.com) point GitHub
# at a test stub; they are refused at boot unless ALLOW_TEST_OVERRIDES=1 (CI, the integration runner, and local
# sign-in through `npm run github:stub` — README, "Sign in locally").

# Mail: `log` (default in development and test) writes each message to the app log as one `mail.sent`
# line, with the link readable; `resend` (default in production) sends it through Resend's HTTP API.
# Production refuses `log` unless ALLOW_TEST_OVERRIDES=1 (integration runner only).
MAIL_PROVIDER=log
# Resend API key and sender (a verified domain, e.g. `DevMentor <noreply@example.com>`). Required in
# production with `resend`; when missing, registration mail fails with 503.
MAIL_API_KEY=
MAIL_FROM=

# Comma-separated operator (admin) emails; empty = no operator.
OPERATOR_EMAILS=mock-operator@devmentor.test

# Proxies in front of the app that append the client IP to x-forwarded-for (the IP is read that many
# entries from the right). 0 = no proxy is trusted: per-IP rate limits are skipped, per-email ones stay.
TRUSTED_PROXY_HOPS=0
# Password hashing gate: concurrent scrypt hashes (~128 MiB each) and how long a request waits for a
# slot before a 503.
PASSWORD_HASH_CONCURRENCY=2
PASSWORD_HASH_WAIT_MS=3000

# Mentor invitations: days an invitation link stays valid (stored per invitation at creation), and days a
# new mentor has to publish their first slot after accepting. Whole days, 1–365; empty = 14.
INVITATION_TTL_DAYS=14
MENTOR_PUBLISH_WINDOW_DAYS=14

# Mentor prices (founder decision 2026-11-20, spec 2026-10-21-mentor-prices): one platform currency and the
# 25- and 50-minute bounds in minor units (grosze). Set both or neither: a half-set or malformed pair refuses
# boot; unset = prices cannot be saved (503) and no mentor is bookable. Change bounds by hand (R16).
PLATFORM_CURRENCY=PLN
PLATFORM_PRICE_BOUNDS='{"25":{"minCents":5000,"maxCents":30000},"50":{"minCents":10000,"maxCents":60000}}'
