{
  "name": "devmentor",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev -w @devmentor/app",
    "build": "npm run build -w @devmentor/app",
    "start": "npm run start -w @devmentor/app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db": "npm run mikro-orm -w @devmentor/db --",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "node scripts/audit.mjs",
    "validate": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run audit",
    "db:migrate": "npm run db -- migration:up",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mts"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "agent-browser": "^0.39.1",
    "jsdom": "^30.1.3",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.5"
  }
}
